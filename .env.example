POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blogology
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/blogology"

REDIS_URL="redis://localhost:6379"

PORT=5000

SESSION_SECRET="change-this-to-a-long-random-string-in-production"

GEMINI_API_KEY=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/v1/auth/google/callback"

# Frontend URL (for redirecting after OAuth completion)
FRONTEND_URL="http://localhost:3000"

# Mailer (Optional for dev — falls back to terminal preview / Ethereal)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Blogology <no-reply@blogology.local>"

# Stripe Test Mode
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
